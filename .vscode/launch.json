{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django Debug Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:8001",
                "--noreload"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "DJANGO_DEBUG": "True",
                "DJANGO_SETTINGS_MODULE": "devtest.config.settings"
            }
        },
        {
            "name": "Django Test Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "test"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "DJANGO_DEBUG": "True",
                "DJANGO_SETTINGS_MODULE": "devtest.config.settings"
            }
        },
        {
            "name": "Django Shell Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "shell"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "DJANGO_DEBUG": "True",
                "DJANGO_SETTINGS_MODULE": "devtest.config.settings"
            }
        },
        {
            "name": "Celery Worker Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "celery",
            "args": [
                "-A",
                "devtest.config.celery",
                "worker",
                "--loglevel=info"
            ],
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "DJANGO_DEBUG": "True",
                "DJANGO_SETTINGS_MODULE": "devtest.config.settings"
            }
        }
    ]
}
