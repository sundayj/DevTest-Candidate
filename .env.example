# Copy this file to `.devcontainer/.env` and replace the values with the correct values
# Database Configuration (host is auto-detected at runtime)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5433
PGPORT=5433

# Redis Configuration (host is auto-detected at runtime)
REDIS_PORT=6380

# PostgreSQL Service Configuration (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
